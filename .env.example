# DeepSeek Harness (dsh) 环境变量模板
# 复制本文件为 .env 并填入你的真实 key（.env 已被 .gitignore 忽略）
#
# 凭证解析优先级（高→低）：
#   1. 进程环境变量
#   2. ~/.dsh/.credentials.yaml（dsh 托管存储，0600 权限）
#   3. 工作目录 .env
#   4. ~/.dsh/.env
#
# 申请 API Key：https://platform.deepseek.com/api_keys

DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
